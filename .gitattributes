# .config/outdatty.lock merges key by key: outdatty's own `outdatty merge-lock`,
# which `just install-hooks` registers. Delete this line to fall back to git's
# text merge.
.config/outdatty.lock merge=outdatty
# .config/jscpd-baseline.json merges as the union of both sides' fingerprints:
# .just/scripts/jscpd-baseline-merge.sh, which `just install-hooks` registers.
# Delete this line to fall back to git's text merge.
.config/jscpd-baseline.json merge=jscpd-baseline
# .config/crap-baseline.json merges entry by entry, keyed as the ratchet pairs
# them: .just/scripts/crap-baseline-merge.sh, which `just install-hooks`
# registers. Delete this line to fall back to git's text merge.
.config/crap-baseline.json merge=crap-baseline
# The schema goldens are compared byte for byte with what the generator
# writes, which is LF. Without this, Windows checks them out as CRLF and both
# `schema_matches_golden` tests fail there.
schema/*.json text eol=lf
