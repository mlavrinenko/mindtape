# Copy this file to `.env` and fill in both values. `.env` is gitignored, so a
# real key stays out of the repository.
#
# `just skill-evals` reads these two variables. The model id names a provider
# opencode knows, in `provider/model` form.
SKILL_EVALS_MODEL_ID=example-provider/example-model
SKILL_EVALS_API_KEY=replace-with-a-real-key
