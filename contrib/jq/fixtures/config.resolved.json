{
  "config": {
    "actors": [
      {
        "kind": "human",
        "name": "max",
        "roles": [
          "maintainer"
        ]
      },
      {
        "kind": "llm",
        "name": "agent",
        "roles": []
      }
    ],
    "add": {
      "comments": false,
      "header": "",
      "interactive": "auto",
      "verify-when": "!tty()"
    },
    "commits": {
      "external-refs": [],
      "rules": [
        {
          "assert": "has(refs)",
          "message": "name the task this commit works on in a `Refs: <stem>` footer",
          "name": "name-task-in-refs-trailer",
          "scope": "commit",
          "severity": "error",
          "when": "!tasks_only && !matches(subject, \"^(fixup|squash|amend)! \") && !matches(subject, \"^chore\\\\(release\\\\): [0-9]+\\\\.[0-9]+\\\\.[0-9]+$\")"
        },
        {
          "assert": "!matches(subject, \"^(fixup|squash|amend)! \")",
          "message": "squash this commit first: git rebase -i --autosquash <target>",
          "name": "squash-every-autosquash-commit",
          "scope": "commit",
          "severity": "error",
          "when": "in_range"
        },
        {
          "assert": "named && (!tasks_only || retires_other || staged(kind == \"decision\") || staged(kind == \"milestone\"))",
          "message": "start or close a task in a commit that carries its work",
          "name": "flip-task-with-its-work",
          "scope": "task",
          "severity": "error",
          "when": "into(\"wip\") || into(\"done\")"
        },
        {
          "assert": "!(status == \"wip\")",
          "message": "run `mt done <stem>` and commit it with the task's last work",
          "name": "finish-named-task-at-tip",
          "scope": "tip",
          "severity": "error"
        },
        {
          "assert": "count(files, \"@source\") <= 1",
          "message": "file a planned task for the rest, since a tweak changes one source file",
          "name": "keep-tweak-to-one-source-file",
          "scope": "task",
          "severity": "error",
          "when": "into(\"done\") && staged(has_tag(\"tweak\"))"
        },
        {
          "assert": "matches(files, \"^CHANGELOG[.]md$\")",
          "message": "add an entry under [Unreleased] in CHANGELOG.md, or add a `Changelog: none` trailer",
          "name": "add-changelog-entry-for-product-change",
          "scope": "commit",
          "severity": "error",
          "when": "count(files, \"@product\") >= 1 && !matches(subject, \"^(fixup|squash|amend)! \") && !matches(trailers, \"(?i)^Changelog: none$\")"
        },
        {
          "assert": "staged(status == \"wip\" || terminal)",
          "message": "flip the task to wip in the first commit that names it (`mt wip <stem>`, staged with the work)",
          "name": "start-named-task-in-its-commit",
          "scope": "task",
          "severity": "error",
          "when": "named && staged(exists)"
        }
      ],
      "run": [
        "bash",
        ".just/scripts/check-commit-prose.sh"
      ],
      "trailer": "Refs"
    },
    "dicts": {
      "product": {
        "case": "exact",
        "include": [],
        "values": [
          "crates/**",
          "lib/**",
          "!crates/*/tests/**",
          "!**/*test*.rs"
        ]
      },
      "source": {
        "case": "exact",
        "include": [],
        "values": [
          "!README.md",
          "!CONTRIBUTING.md",
          "!AGENTS.md",
          "!skills/mindtape/SKILL.md",
          "!docs/contributing/*.md",
          "!www/generated/**",
          "!.config/outdatty.lock",
          "!docs/src/**",
          "!www/content/**",
          "!CHANGELOG.md",
          "!truth/tasks/**",
          "!crates/*/tests/**",
          "!**/*test*.rs",
          "!examples/**",
          "!.config/crap-baseline.json",
          "!.config/jscpd-baseline.json"
        ]
      },
      "verbs": {
        "case": "fold",
        "include": [
          "mindtape-verbs",
          "mindtape-dev-verbs"
        ],
        "values": []
      }
    },
    "format": {
      "enabled": true
    },
    "go": {},
    "ls": {
      "columns": {
        "assignee": {
          "when": "contested()"
        },
        "children": {
          "when": "named()"
        },
        "due": {
          "when": "nonempty()"
        },
        "file": {
          "when": "named() || (!tty() && format() == \"table\")"
        },
        "priority": {
          "when": "nonempty()"
        },
        "progress": {
          "when": "named()"
        },
        "ready": {
          "when": "blocked()"
        },
        "slug#": {
          "when": "true"
        },
        "status": {
          "when": "nonempty()"
        },
        "title": {
          "when": "true"
        },
        "why": {
          "when": "named()"
        }
      },
      "columns-order": [],
      "contains-fields": [],
      "default-sort": [],
      "hyperlinks": "auto",
      "overdue-color": "red",
      "ready": {
        "blocked-color": "red",
        "blocked-glyph": "🔒",
        "blocked-label": "blocked",
        "ready-color": "green",
        "ready-glyph": "▶",
        "ready-label": "ready"
      },
      "rules": []
    },
    "on": {
      "add": [
        {
          "actions": [
            {
              "append": {},
              "dir": "truth/tasks/{date:YYYY}-{date:MM}",
              "set": {}
            }
          ],
          "name": "file-by-month",
          "when": "!has_tag(\"swept\")"
        },
        {
          "actions": [
            {
              "append": {},
              "dir": "truth/tasks/swept",
              "set": {}
            }
          ],
          "name": "sweeps",
          "when": "has_tag(\"swept\")"
        }
      ],
      "flip": [
        {
          "actions": [
            {
              "gate": true,
              "message": "re-read the scope against today's code, fix what went stale, run `mt review`, then start again"
            }
          ],
          "name": "review-stale-task-before-starting",
          "when": "into(\"wip\") && stale(30)"
        },
        {
          "actions": [
            {
              "gate": true,
              "message": "run `just check`, then flip again",
              "run": "mmz --is-fresh --tag gate"
            }
          ],
          "name": "close-only-on-fresh-gate",
          "when": "into(\"done\") || into(\"cancelled\") || into(\"failed\")"
        }
      ],
      "rm": []
    },
    "project": {},
    "retire": {},
    "rm": {
      "default-filter": "terminal"
    },
    "roles": [
      {
        "name": "maintainer"
      }
    ],
    "tasks": {
      "assignee": {
        "allowed": [
          "max",
          "agent"
        ],
        "example": "agent",
        "required": "!terminal"
      },
      "body": {
        "content": {
          "rules": [
            {
              "assert": {
                "must-match": "(?m)^\\s*(\\+|\\d+\\.)\\s"
              },
              "message": "write AS-IS as numbered steps anyone can follow",
              "name": "write-as-is-as-numbered-steps",
              "path": [
                "AS-IS"
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "must-match": "(?m)^\\s*(\\+|\\d+\\.)\\s+🔴"
              },
              "message": "open the step that shows the defect with 🔴",
              "name": "mark-defect-step-with-red",
              "path": [
                "AS-IS"
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "must-match": "[`]{3}"
              },
              "message": "show the bug in one fenced block you can run, or tag the task `no-repro`",
              "name": "add-fenced-repro-to-as-is",
              "path": [
                "AS-IS"
              ],
              "when": "!terminal && true && kind == \"fix\" && !has_tag(\"no-repro\")"
            },
            {
              "assert": {
                "must-match": "(?m)^\\s*- 🟢"
              },
              "message": "say how it should work as bullets opening with 🟢",
              "name": "open-to-be-bullet-with-green",
              "path": [
                "TO-BE"
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "must-not-match": "(?m)^\\s*- [^🟢]"
              },
              "message": "open every TO-BE bullet with 🟢",
              "name": "open-every-to-be-bullet-with-green",
              "path": [
                "TO-BE"
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "must-match": "[`]{3}"
              },
              "message": "show the proposed shape in a fenced example, or tag the task `no-ui-ux`",
              "name": "add-fenced-example-to-to-be",
              "path": [
                "TO-BE"
              ],
              "when": "!terminal && true && (kind == \"feat\" || kind == \"fix\" || kind == \"dev\") && !has_tag(\"no-ui-ux\")"
            },
            {
              "assert": {
                "must-match": "(?m)^[ \\t]*-[ \\t]+`[^`]+`"
              },
              "message": "list Changes as bullets naming the `path` each one touches",
              "name": "name-path-in-changes",
              "path": [
                "Changes"
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "must-not-match": "(?m)^[ \\t]*-[ \\t]+[^`\\n]"
              },
              "message": "start every Changes bullet with one backticked path, then what changes there",
              "name": "start-every-changes-bullet-with-path",
              "path": [
                "Changes"
              ],
              "when": "!terminal"
            },
            {
              "assert": "non-empty",
              "message": "write the plan under Changes, one backticked path per bullet",
              "name": "write-changes-plan",
              "path": [
                "Changes"
              ],
              "when": "!terminal"
            },
            {
              "assert": "non-empty",
              "message": "write what belongs under the heading, or why nothing does, or remove it",
              "name": "leave-no-listed-section-empty",
              "path": [
                {
                  "match": "^(Out of scope|Environment|Source of truth|Alternatives|Rollback)$",
                  "recursive": false
                }
              ],
              "when": "!terminal"
            },
            {
              "assert": "non-empty",
              "message": "write the state the change starts from, or remove the section",
              "name": "write-as-is-section",
              "path": [
                "AS-IS"
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "words": {
                  "max": 120
                }
              },
              "message": "cut this section to under 120 words, or split the task in two",
              "name": "cap-every-listed-section-at-120-words",
              "path": [
                {
                  "match": "^(Environment|TO-BE|Source of truth|Alternatives|Rollback|Out of scope)$",
                  "recursive": false
                }
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "words": {
                  "max": 120
                }
              },
              "message": "cut this section to under 120 words, or split the task in two",
              "name": "cap-as-is-at-120-words",
              "path": [
                "AS-IS"
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "words": {
                  "max": 220
                }
              },
              "message": "cut this section to under 220 words, or split the task in two",
              "name": "cap-changes-at-220-words",
              "path": [
                "Changes"
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "must-match": "[`]{3}"
              },
              "message": "show the proposed config shape in a block",
              "name": "show-proposed-shape-when-gating",
              "path": [
                "TO-BE"
              ],
              "when": "has_tag(\"gating\") && !terminal"
            },
            {
              "assert": {
                "density": {
                  "max": 1,
                  "pattern": "—",
                  "per": "paragraph"
                }
              },
              "message": "keep one em dash per paragraph at most; use a comma, a colon or a second sentence for the rest",
              "name": "keep-at-most-one-em-dash-per-paragraph",
              "path": [
                {
                  "match": ".*",
                  "recursive": false
                }
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "density": {
                  "max": 0,
                  "pattern": "\\?(\\s|$)",
                  "per": "sentence"
                }
              },
              "message": "ask the user and write the answer in, since a task leaves no question open",
              "name": "leave-no-question-open",
              "path": [
                {
                  "match": "TO-BE|Changes|Out of scope|Dogfood",
                  "recursive": false
                }
              ],
              "when": "!terminal"
            },
            {
              "assert": "non-empty",
              "message": "write how this repo uses the change under Dogfood, or \"Not applicable\" and why",
              "name": "write-dogfood-section",
              "path": [
                "Dogfood"
              ],
              "when": "!terminal"
            },
            {
              "assert": {
                "words": {
                  "max": 120
                }
              },
              "message": "cut this section to under 120 words, or split the task in two",
              "name": "cap-dogfood-at-120-words",
              "path": [
                "Dogfood"
              ],
              "when": "!terminal"
            },
            {
              "assert": "non-empty",
              "message": "write the goal block under `Goals`; an empty section rates nothing",
              "name": "write-goals-section",
              "path": [
                "Goals"
              ],
              "when": "!terminal && !has(x-goals)"
            },
            {
              "assert": {
                "words": {
                  "count": "text",
                  "max": 160
                }
              },
              "message": "cut the goal reasons to under 160 words",
              "name": "cap-goals-at-160-words",
              "path": [
                "Goals"
              ],
              "when": "!terminal && !has(x-goals)"
            }
          ],
          "words": {
            "count": "prose"
          }
        },
        "headers": {
          "rules": [
            {
              "action": "allowlist",
              "after": [],
              "allowed": [
                {
                  "match": "^(AS-IS|Environment|TO-BE|Source of truth|Changes|Alternatives|Rollback|Out of scope|Dogfood|Goals)$",
                  "recursive": false
                }
              ],
              "before": [],
              "message": "limit an open task to AS-IS, TO-BE, Changes, Out of scope, Dogfood and Goals, plus its kind's own section",
              "name": "allow-only-declared-sections",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "add one Environment section saying where the AS-IS reproduces",
              "name": "require-environment-for-fix",
              "path": [
                "Environment"
              ],
              "scope": [],
              "when": "!terminal && kind == \"fix\""
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "add one Alternatives section naming the designs you rejected",
              "name": "require-alternatives-for-design",
              "path": [
                "Alternatives"
              ],
              "scope": [],
              "when": "!terminal && (kind == \"feat\" || kind == \"decision\")"
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "add one Source of truth section naming what the prose must match",
              "name": "require-source-of-truth-for-docs",
              "path": [
                "Source of truth"
              ],
              "scope": [],
              "when": "!terminal && kind == \"docs\""
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "add one Rollback section saying how to undo the change",
              "name": "require-rollback-for-stateful-change",
              "path": [
                "Rollback"
              ],
              "scope": [],
              "when": "!terminal && has_tag(\"stateful\")"
            },
            {
              "action": "forbid",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "remove the Environment section; only fix tasks have one",
              "name": "allow-environment-only-for-fix",
              "path": [
                "Environment"
              ],
              "scope": [],
              "when": "!terminal && kind != \"fix\""
            },
            {
              "action": "forbid",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "remove the Alternatives section; only feat and decision tasks have one",
              "name": "allow-alternatives-only-for-design",
              "path": [
                "Alternatives"
              ],
              "scope": [],
              "when": "!terminal && kind != \"feat\" && kind != \"decision\""
            },
            {
              "action": "forbid",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "remove the Source of truth section; only docs tasks have one",
              "name": "allow-source-of-truth-only-for-docs",
              "path": [
                "Source of truth"
              ],
              "scope": [],
              "when": "!terminal && kind != \"docs\""
            },
            {
              "action": "forbid",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "remove the Rollback section; only a stateful task has one",
              "name": "allow-rollback-only-for-stateful-change",
              "path": [
                "Rollback"
              ],
              "scope": [],
              "when": "!terminal && !has_tag(\"stateful\")"
            },
            {
              "action": "order",
              "after": [
                "Environment"
              ],
              "allowed": [],
              "before": [
                "AS-IS"
              ],
              "message": "move Environment after AS-IS",
              "name": "put-environment-after-as-is",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "TO-BE"
              ],
              "allowed": [],
              "before": [
                "AS-IS"
              ],
              "message": "move TO-BE after AS-IS",
              "name": "put-to-be-after-as-is",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "Source of truth"
              ],
              "allowed": [],
              "before": [
                "TO-BE"
              ],
              "message": "move Source of truth after TO-BE",
              "name": "put-source-of-truth-after-to-be",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "Changes"
              ],
              "allowed": [],
              "before": [
                "TO-BE"
              ],
              "message": "move Changes after TO-BE",
              "name": "put-changes-after-to-be",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "Changes"
              ],
              "allowed": [],
              "before": [
                "Source of truth"
              ],
              "message": "move Changes after Source of truth",
              "name": "put-changes-after-source-of-truth",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "Alternatives"
              ],
              "allowed": [],
              "before": [
                "Changes"
              ],
              "message": "move Alternatives after Changes",
              "name": "put-alternatives-after-changes",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "Rollback"
              ],
              "allowed": [],
              "before": [
                "Changes"
              ],
              "message": "move Rollback after Changes",
              "name": "put-rollback-after-changes",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "Out of scope"
              ],
              "allowed": [],
              "before": [
                "Changes"
              ],
              "message": "move Out of scope after Changes",
              "name": "put-out-of-scope-after-changes",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "Out of scope"
              ],
              "allowed": [],
              "before": [
                "Alternatives"
              ],
              "message": "move Out of scope after Alternatives",
              "name": "put-out-of-scope-after-alternatives",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "Out of scope"
              ],
              "allowed": [],
              "before": [
                "Rollback"
              ],
              "message": "move Out of scope after Rollback",
              "name": "put-out-of-scope-after-rollback",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "keep exactly one AS-IS section",
              "name": "keep-one-as-is-section",
              "path": [
                "AS-IS"
              ],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "keep exactly one TO-BE section",
              "name": "keep-one-to-be-section",
              "path": [
                "TO-BE"
              ],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "keep exactly one Changes section",
              "name": "keep-one-changes-section",
              "path": [
                "Changes"
              ],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "keep exactly one Out of scope section",
              "name": "keep-one-out-of-scope-section",
              "path": [
                "Out of scope"
              ],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "forbid",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "remove the subsections, or split the task; a section takes none",
              "name": "keep-sections-flat",
              "path": [
                {
                  "match": ".*",
                  "recursive": false
                },
                {
                  "match": ".*",
                  "recursive": false
                }
              ],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "add one Dogfood section saying how this repo will dogfood the task (\"Not applicable\" with a reason opts out)",
              "name": "keep-one-dogfood-section",
              "path": [
                "Dogfood"
              ],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "order",
              "after": [
                "Dogfood"
              ],
              "allowed": [],
              "before": [
                "Out of scope"
              ],
              "message": "move Dogfood after Out of scope",
              "name": "put-dogfood-after-out-of-scope",
              "path": [],
              "scope": [],
              "when": "!terminal"
            },
            {
              "action": "unique",
              "after": [],
              "allowed": [],
              "before": [],
              "message": "rate every goal under one `== Goals` heading",
              "name": "keep-one-goals-section",
              "path": [
                "Goals"
              ],
              "scope": [],
              "when": "!terminal && !has(x-goals)"
            },
            {
              "action": "order",
              "after": [
                "Goals"
