        }
      ],
      "rules": [
        {
          "assert": "has_tag(\"stateful\") || has_tag(\"stateless\")",
          "message": "tag the task `stateful` or `stateless`, so the Rollback rule knows which applies",
          "name": "tag-task-stateful-or-stateless",
          "severity": "error",
          "when": "!terminal && true && kind != \"decision\""
        },
        {
          "assert": "in_dict(\"verbs\", word(title, 1))",
          "message": "start the title with an imperative verb",
          "name": "start-title-with-verb",
          "severity": "error",
          "when": "!terminal"
        },
        {
          "assert": "count(status == \"wip\" && kind == \"milestone\") <= 1",
          "message": "close or split the open milestone before opening another",
          "name": "keep-one-milestone-in-progress",
          "severity": "error",
          "when": "status == \"wip\" && kind == \"milestone\""
        },
        {
          "assert": "count(status == \"wip\" && kind != \"milestone\") <= 1",
          "message": "finish the open task, or split off what is done and close that, before starting another",
          "name": "keep-one-task-in-progress",
          "severity": "error",
          "when": "status == \"wip\" && kind != \"milestone\""
        },
        {
          "assert": "count_paths(derived.changes, \"@source\") <= 5",
          "message": "split the decision from the mechanical fan-out instead of widening the cap",
          "name": "cap-judgment-work-at-max-source-files",
          "severity": "error",
          "when": "!terminal && kind != \"milestone\" && difficulty >= 3"
        },
        {
          "assert": "changed(\"staged+worktree\", \"@source\") <= count_paths(derived.changes, \"@source\")",
          "message": "move work not yet written into a new task; what is already written ships with this one, so closing it needs no split",
          "name": "keep-work-inside-changes-plan",
          "severity": "warn",
          "when": "status == \"wip\""
        },
        {
          "assert": "terminal",
          "message": "file a tweak done, in the commit that makes the change: `mt add -t tweak`; plan anything bigger with another template",
          "name": "file-tweak-done",
          "severity": "error",
          "when": "has_tag(\"tweak\")"
        },
        {
          "check": {
            "field": "markers",
            "function": "check-goal-over",
            "typst": "truth/lib.typ"
          },
          "name": "give-every-goal-verdict",
          "severity": "error",
          "when": "!terminal && !has(x-goals)"
        },
        {
          "assert": "miss(x-goals)",
          "message": "move `x-goals` into `== Goals`; the goal check reads markers. A reopened legacy task warns until it is re-rated.",
          "name": "warn-on-x-goals-on-open-tasks",
          "severity": "warn",
          "when": "!terminal && matches(dir, \"^truth/tasks/\")"
        },
        {
          "assert": "matches(dir, \"^truth/tasks/[0-9]{4}-[0-9]{2}$\")",
          "message": "file a task in `truth/tasks/YYYY-MM/`, the month it was filed",
          "name": "file-tasks-by-month",
          "severity": "error",
          "when": "!has_tag(\"swept\")"
        },
        {
          "assert": "dir == \"truth/tasks/swept\"",
          "message": "file a swept task in `truth/tasks/swept/`",
          "name": "sweeps-live-in-their-folder",
          "severity": "error",
          "when": "has_tag(\"swept\")"
        },
        {
          "assert": "links(\"surfaced-by\")",
          "message": "link the finding to the task that surfaced it with `mt link <finding> surfaced-by <task>`",
          "name": "link-finding-to-what-surfaced-it",
          "severity": "error",
          "when": "!terminal && has_tag(\"found\")"
        }
