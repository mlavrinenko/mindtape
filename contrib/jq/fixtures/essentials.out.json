{
  "actors": [
    {
      "kind": "human",
      "name": "max",
      "roles": [
        "maintainer"
      ]
    },
    {
      "kind": "llm",
      "name": "agent",
      "roles": []
    }
  ],
  "add": {
    "comments": false,
    "header": "",
    "interactive": "auto",
    "verify-when": "!tty()"
  },
  "commits": {
    "trailer": "Refs",
    "run": [
      "bash",
      ".just/scripts/check-commit-prose.sh"
    ],
    "external-refs": [],
    "rules": [
      {
        "assert": "has(refs)",
        "message": "name the task this commit works on in a `Refs: <stem>` footer",
        "name": "name-task-in-refs-trailer",
        "scope": "commit",
        "severity": "error",
        "when": "!tasks_only && !matches(subject, \"^(fixup|squash|amend)! \") && !matches(subject, \"^chore\\\\(release\\\\): [0-9]+\\\\.[0-9]+\\\\.[0-9]+$\")",
        "section": "commits.rules",
        "label": "name-task-in-refs-trailer",
        "moments": [
          "commit"
        ]
      },
      {
        "assert": "!matches(subject, \"^(fixup|squash|amend)! \")",
        "message": "squash this commit first: git rebase -i --autosquash <target>",
        "name": "squash-every-autosquash-commit",
        "scope": "commit",
        "severity": "error",
        "when": "in_range",
        "section": "commits.rules",
        "label": "squash-every-autosquash-commit",
        "moments": [
          "commit"
        ]
      },
      {
        "assert": "named && (!tasks_only || retires_other || staged(kind == \"decision\") || staged(kind == \"milestone\"))",
        "message": "start or close a task in a commit that carries its work",
        "name": "flip-task-with-its-work",
        "scope": "task",
        "severity": "error",
        "when": "into(\"wip\") || into(\"done\")",
        "section": "commits.rules",
        "label": "flip-task-with-its-work",
        "moments": [
          "commit"
        ]
      },
      {
        "assert": "!(status == \"wip\")",
        "message": "run `mt done <stem>` and commit it with the task's last work",
        "name": "finish-named-task-at-tip",
        "scope": "tip",
        "severity": "error",
        "section": "commits.rules",
        "label": "finish-named-task-at-tip",
        "moments": [
          "commit"
        ]
      },
      {
        "assert": "count(files, \"@source\") <= 1",
        "message": "file a planned task for the rest, since a tweak changes one source file",
        "name": "keep-tweak-to-one-source-file",
        "scope": "task",
        "severity": "error",
        "when": "into(\"done\") && staged(has_tag(\"tweak\"))",
        "section": "commits.rules",
        "label": "keep-tweak-to-one-source-file",
        "moments": [
          "commit"
        ]
      },
      {
        "assert": "matches(files, \"^CHANGELOG[.]md$\")",
        "message": "add an entry under [Unreleased] in CHANGELOG.md, or add a `Changelog: none` trailer",
        "name": "add-changelog-entry-for-product-change",
        "scope": "commit",
        "severity": "error",
        "when": "count(files, \"@product\") >= 1 && !matches(subject, \"^(fixup|squash|amend)! \") && !matches(trailers, \"(?i)^Changelog: none$\")",
        "section": "commits.rules",
        "label": "add-changelog-entry-for-product-change",
        "moments": [
          "commit"
        ]
      },
      {
        "assert": "staged(status == \"wip\" || terminal)",
        "message": "flip the task to wip in the first commit that names it (`mt wip <stem>`, staged with the work)",
        "name": "start-named-task-in-its-commit",
        "scope": "task",
        "severity": "error",
        "when": "named && staged(exists)",
        "section": "commits.rules",
        "label": "start-named-task-in-its-commit",
        "moments": [
          "commit"
        ]
      }
    ]
  },
  "dicts": {
    "product": {
      "case": "exact",
      "include": [],
      "values": [
        "crates/**",
        "lib/**",
        "!crates/*/tests/**",
        "!**/*test*.rs"
      ]
    },
    "source": {
      "case": "exact",
      "include": [],
      "values": [
        "!README.md",
        "!CONTRIBUTING.md",
        "!AGENTS.md",
        "!skills/mindtape/SKILL.md",
        "!docs/contributing/*.md",
        "!www/generated/**",
        "!.config/outdatty.lock",
        "!docs/src/**",
        "!www/content/**",
        "!CHANGELOG.md",
        "!truth/tasks/**",
        "!crates/*/tests/**",
        "!**/*test*.rs",
        "!examples/**",
        "!.config/crap-baseline.json",
        "!.config/jscpd-baseline.json"
      ]
    },
    "verbs": {
      "case": "fold",
      "include": [
        "mindtape-verbs",
        "mindtape-dev-verbs"
      ],
      "values": []
    }
  },
  "go": {},
  "on": {
    "add": [
      {
        "actions": [
          {
            "append": {},
            "dir": "truth/tasks/{date:YYYY}-{date:MM}",
            "set": {}
          }
        ],
        "name": "file-by-month",
        "when": "!has_tag(\"swept\")",
        "section": "on.add",
        "label": "file-by-month",
        "moments": [
          "add"
        ]
      },
      {
        "actions": [
          {
            "append": {},
            "dir": "truth/tasks/swept",
            "set": {}
          }
        ],
        "name": "sweeps",
        "when": "has_tag(\"swept\")",
        "section": "on.add",
        "label": "sweeps",
        "moments": [
          "add"
        ]
      }
    ],
    "flip": [
      {
        "actions": [
          {
            "gate": true,
            "message": "re-read the scope against today's code, fix what went stale, run `mt review`, then start again"
          }
        ],
        "name": "review-stale-task-before-starting",
        "when": "into(\"wip\") && stale(30)",
        "section": "on.flip",
        "label": "review-stale-task-before-starting",
        "moments": [
          "flip"
        ]
      },
      {
        "actions": [
          {
            "gate": true,
            "message": "run `just check`, then flip again",
            "run": "mmz --is-fresh --tag gate"
          }
        ],
        "name": "close-only-on-fresh-gate",
        "when": "into(\"done\") || into(\"cancelled\") || into(\"failed\")",
        "section": "on.flip",
        "label": "close-only-on-fresh-gate",
        "moments": [
          "flip"
        ]
      }
    ],
    "rm": []
  },
  "project": {},
  "retire": {},
  "rm": {
    "default-filter": "terminal"
  },
  "roles": [
    {
      "name": "maintainer"
    }
  ],
  "tasks": {
    "roots": [
      {
        "path": "truth/tasks",
        "tag": "mt",
        "exclude": [],
        "derive-tags": true
      }
    ],
    "statuses": [
      {
        "color": "blue",
        "glyph": "💡",
        "note": "optional",
        "terminal": false,
        "to": [
          "accepted",
          "wip",
          "cancelled"
        ],
        "unblocked": false,
        "value": "proposed"
      },
      {
        "color": "cyan",
        "glyph": "📋",
        "note": "optional",
        "terminal": false,
        "to": [
          "wip",
          "cancelled"
        ],
        "unblocked": false,
        "value": "accepted"
      },
      {
        "color": "yellow",
        "glyph": "🔨",
        "note": "optional",
        "terminal": false,
        "to": [
          "done",
          "failed",
          "accepted"
        ],
        "unblocked": true,
        "value": "wip"
      },
      {
        "color": "green",
        "glyph": "✅",
        "note": "optional",
        "terminal": true,
        "to": [
          "wip",
          "cancelled",
          "failed"
        ],
        "unblocked": true,
        "value": "done"
      },
      {
        "color": "magenta",
        "glyph": "🚫",
        "note": "optional",
        "terminal": true,
        "to": [],
        "unblocked": false,
        "value": "cancelled"
      },
      {
        "color": "red",
        "glyph": "❌",
        "note": "optional",
        "terminal": true,
        "to": [
          "wip"
        ],
        "unblocked": false,
        "value": "failed"
      }
    ],
    "assignee": {
      "allowed": [
        "max",
        "agent"
      ],
      "example": "agent",
      "required": "!terminal"
    },
    "priority": {
      "framework": "ice",
      "kind": "int",
      "min": 0.0,
      "max": 9.0,
      "required": "!terminal",
      "allow-manual": false,
      "score": "round(impact * confidence * ease * 0.09)",
      "inputs": {
        "confidence": {
          "max": 1.0,
          "min": 0.0,
          "type": "number",
          "values": []
        },
        "ease": {
          "max": 10.0,
          "min": 1.0,
          "type": "number",
          "values": []
        },
        "impact": {
          "max": 10.0,
          "min": 1.0,
          "type": "number",
          "values": []
        }
      }
    },
    "difficulty": {
      "anchors": [
        {
          "color": "green",
          "glyph": "🟢",
          "label": "junior",
          "value": 0.0
        },
        {
          "color": "cyan",
          "glyph": "🔵",
          "label": "mid",
          "value": 3.0
        },
        {
          "color": "yellow",
          "glyph": "🟡",
          "label": "senior",
          "value": 6.0
        },
        {
          "color": "red",
          "glyph": "🔴",
          "label": "staff",
          "value": 9.0
        }
      ],
      "bands": [],
      "example": 3.0,
      "kind": "int",
      "max": 9.0,
      "min": 0.0,
      "required": "!terminal"
    },
    "estimate": {
      "example": {
        "src-files": 1.0
      },
      "queries": {},
      "required": false,
      "units": [
        "src-files"
      ]
    },
    "kinds": {
      "example": "test",
      "multiple": false,
      "required": "!terminal",
      "values": [
        "feat",
        "fix",
        "refactor",
        "docs",
        "test",
        "dev",
        "decision",
        "milestone"
      ]
    },
    "link-kinds": [
      {
        "acyclic": true,
        "blocking": false,
        "max": 1,
        "name": "surfaced-by",
        "note": "optional",
        "validate": "local-task-path"
      }
    ],
    "comments": {
      "policy": "forbid"
    },
    "extensions": [],
    "tags": {
      "allowed": [
        "mt",
        "substrate",
        "speconaut",
        "cli",
        "tests",
        "www",
        "docs",
        "tooling",
        "gating",
        "stateful",
        "stateless",
        "no-repro",
        "no-ui-ux",
        "swept",
        "size",
        "mutants",
        "coverage",
        "repeats",
        "dry",
        "found",
        "tweak"
      ]
    },
    "derive-tags": {
      "breadcrumb-root": false,
      "collect": [],
      "enabled": false,
      "separator": ":",
      "slugify": true
    },
    "collectors": [
      {
        "name": "changes",
        "query": {
          "pattern": "(?m)^\\s*-\\s+`([^`]+)`",
          "section": "Changes"
        },
        "returns": [
          "path"
        ],
        "when": "!terminal"
      }
    ],
    "waits": [],
    "rules": [
      {
        "assert": "has_tag(\"stateful\") || has_tag(\"stateless\")",
        "message": "tag the task `stateful` or `stateless`, so the Rollback rule knows which applies",
        "name": "tag-task-stateful-or-stateless",
        "severity": "error",
        "when": "!terminal && true && kind != \"decision\"",
        "section": "tasks.rules",
        "label": "tag-task-stateful-or-stateless",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "in_dict(\"verbs\", word(title, 1))",
        "message": "start the title with an imperative verb",
        "name": "start-title-with-verb",
        "severity": "error",
        "when": "!terminal",
        "section": "tasks.rules",
        "label": "start-title-with-verb",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "count(status == \"wip\" && kind == \"milestone\") <= 1",
        "message": "close or split the open milestone before opening another",
        "name": "keep-one-milestone-in-progress",
        "severity": "error",
        "when": "status == \"wip\" && kind == \"milestone\"",
        "section": "tasks.rules",
        "label": "keep-one-milestone-in-progress",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "count(status == \"wip\" && kind != \"milestone\") <= 1",
        "message": "finish the open task, or split off what is done and close that, before starting another",
        "name": "keep-one-task-in-progress",
        "severity": "error",
        "when": "status == \"wip\" && kind != \"milestone\"",
        "section": "tasks.rules",
        "label": "keep-one-task-in-progress",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "count_paths(derived.changes, \"@source\") <= 5",
        "message": "split the decision from the mechanical fan-out instead of widening the cap",
        "name": "cap-judgment-work-at-max-source-files",
        "severity": "error",
        "when": "!terminal && kind != \"milestone\" && difficulty >= 3",
        "section": "tasks.rules",
        "label": "cap-judgment-work-at-max-source-files",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "changed(\"staged+worktree\", \"@source\") <= count_paths(derived.changes, \"@source\")",
        "message": "move work not yet written into a new task; what is already written ships with this one, so closing it needs no split",
        "name": "keep-work-inside-changes-plan",
        "severity": "warn",
        "when": "status == \"wip\"",
        "section": "tasks.rules",
        "label": "keep-work-inside-changes-plan",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "terminal",
        "message": "file a tweak done, in the commit that makes the change: `mt add -t tweak`; plan anything bigger with another template",
        "name": "file-tweak-done",
        "severity": "error",
        "when": "has_tag(\"tweak\")",
        "section": "tasks.rules",
        "label": "file-tweak-done",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "check": {
          "field": "markers",
          "function": "check-goal-over",
          "typst": "truth/lib.typ"
        },
        "name": "give-every-goal-verdict",
        "severity": "error",
        "when": "!terminal && !has(x-goals)",
        "section": "tasks.rules",
        "label": "give-every-goal-verdict",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "miss(x-goals)",
        "message": "move `x-goals` into `== Goals`; the goal check reads markers. A reopened legacy task warns until it is re-rated.",
        "name": "warn-on-x-goals-on-open-tasks",
        "severity": "warn",
        "when": "!terminal && matches(dir, \"^truth/tasks/\")",
        "section": "tasks.rules",
        "label": "warn-on-x-goals-on-open-tasks",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "matches(dir, \"^truth/tasks/[0-9]{4}-[0-9]{2}$\")",
        "message": "file a task in `truth/tasks/YYYY-MM/`, the month it was filed",
        "name": "file-tasks-by-month",
        "severity": "error",
        "when": "!has_tag(\"swept\")",
        "section": "tasks.rules",
        "label": "file-tasks-by-month",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "dir == \"truth/tasks/swept\"",
        "message": "file a swept task in `truth/tasks/swept/`",
        "name": "sweeps-live-in-their-folder",
        "severity": "error",
        "when": "has_tag(\"swept\")",
        "section": "tasks.rules",
        "label": "sweeps-live-in-their-folder",
        "moments": [
          "add",
          "flip"
        ]
      },
      {
        "assert": "links(\"surfaced-by\")",
        "message": "link the finding to the task that surfaced it with `mt link <finding> surfaced-by <task>`",
        "name": "link-finding-to-what-surfaced-it",
        "severity": "error",
        "when": "!terminal && has_tag(\"found\")",
        "section": "tasks.rules",
        "label": "link-finding-to-what-surfaced-it",
        "moments": [
          "add",
          "flip"
        ]
      }
    ],
    "body": {
      "headers": [
        {
          "action": "allowlist",
          "after": [],
          "allowed": [
            {
              "match": "^(AS-IS|Environment|TO-BE|Source of truth|Changes|Alternatives|Rollback|Out of scope|Dogfood|Goals)$",
              "recursive": false
            }
          ],
          "before": [],
          "message": "limit an open task to AS-IS, TO-BE, Changes, Out of scope, Dogfood and Goals, plus its kind's own section",
          "name": "allow-only-declared-sections",
          "path": [],
          "scope": [],
          "when": "!terminal",
          "section": "tasks.body.headers",
          "label": "allow-only-declared-sections",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "unique",
          "after": [],
          "allowed": [],
          "before": [],
          "message": "add one Environment section saying where the AS-IS reproduces",
          "name": "require-environment-for-fix",
          "path": [
            "Environment"
          ],
          "scope": [],
          "when": "!terminal && kind == \"fix\"",
          "section": "tasks.body.headers",
          "label": "require-environment-for-fix",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "unique",
          "after": [],
          "allowed": [],
          "before": [],
          "message": "add one Alternatives section naming the designs you rejected",
          "name": "require-alternatives-for-design",
          "path": [
            "Alternatives"
          ],
          "scope": [],
          "when": "!terminal && (kind == \"feat\" || kind == \"decision\")",
          "section": "tasks.body.headers",
          "label": "require-alternatives-for-design",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "unique",
          "after": [],
          "allowed": [],
          "before": [],
          "message": "add one Source of truth section naming what the prose must match",
          "name": "require-source-of-truth-for-docs",
          "path": [
            "Source of truth"
          ],
          "scope": [],
          "when": "!terminal && kind == \"docs\"",
          "section": "tasks.body.headers",
          "label": "require-source-of-truth-for-docs",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "unique",
          "after": [],
          "allowed": [],
          "before": [],
          "message": "add one Rollback section saying how to undo the change",
          "name": "require-rollback-for-stateful-change",
          "path": [
            "Rollback"
          ],
          "scope": [],
          "when": "!terminal && has_tag(\"stateful\")",
          "section": "tasks.body.headers",
          "label": "require-rollback-for-stateful-change",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "forbid",
          "after": [],
          "allowed": [],
          "before": [],
          "message": "remove the Environment section; only fix tasks have one",
          "name": "allow-environment-only-for-fix",
          "path": [
            "Environment"
          ],
          "scope": [],
          "when": "!terminal && kind != \"fix\"",
          "section": "tasks.body.headers",
          "label": "allow-environment-only-for-fix",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "forbid",
          "after": [],
          "allowed": [],
          "before": [],
          "message": "remove the Alternatives section; only feat and decision tasks have one",
          "name": "allow-alternatives-only-for-design",
          "path": [
            "Alternatives"
          ],
          "scope": [],
          "when": "!terminal && kind != \"feat\" && kind != \"decision\"",
          "section": "tasks.body.headers",
          "label": "allow-alternatives-only-for-design",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "forbid",
          "after": [],
          "allowed": [],
          "before": [],
          "message": "remove the Source of truth section; only docs tasks have one",
          "name": "allow-source-of-truth-only-for-docs",
          "path": [
            "Source of truth"
          ],
          "scope": [],
          "when": "!terminal && kind != \"docs\"",
          "section": "tasks.body.headers",
          "label": "allow-source-of-truth-only-for-docs",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "forbid",
          "after": [],
          "allowed": [],
          "before": [],
          "message": "remove the Rollback section; only a stateful task has one",
          "name": "allow-rollback-only-for-stateful-change",
          "path": [
            "Rollback"
          ],
          "scope": [],
          "when": "!terminal && !has_tag(\"stateful\")",
          "section": "tasks.body.headers",
          "label": "allow-rollback-only-for-stateful-change",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "order",
          "after": [
            "Environment"
          ],
          "allowed": [],
          "before": [
            "AS-IS"
          ],
          "message": "move Environment after AS-IS",
          "name": "put-environment-after-as-is",
          "path": [],
          "scope": [],
          "when": "!terminal",
          "section": "tasks.body.headers",
          "label": "put-environment-after-as-is",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "order",
          "after": [
            "TO-BE"
          ],
          "allowed": [],
          "before": [
            "AS-IS"
          ],
          "message": "move TO-BE after AS-IS",
          "name": "put-to-be-after-as-is",
          "path": [],
          "scope": [],
          "when": "!terminal",
          "section": "tasks.body.headers",
          "label": "put-to-be-after-as-is",
          "moments": [
            "add",
            "flip"
          ]
        },
        {
          "action": "order",
          "after": [
            "Source of truth"
          ],
          "allowed": [],
