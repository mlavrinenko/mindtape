  "templates": {
    "check-defaults": false,
    "default": "task",
    "dirs": [
      ".mindtape/templates"
    ],
    "fallback-severity": "warning"
  },
  "views": {
    "agent": {
      "columns": [],
      "description": "Open tasks an agent can take",
      "filter": "assignee == \"agent\" && !terminal",
      "sort": [
        "priority:desc"
      ]
    },
    "ask-refactoring": {
      "columns": [],
      "description": "Open findings from the last `just advisory ask-refactoring` sweep",
      "filter": "has_tag(\"swept\") && !terminal",
      "sort": [
        "priority:desc"
      ]
    },
    "blocked": {
      "columns": [
        "slug#",
        "title",
        "why"
      ],
      "description": "Blocked tasks and what each waits on",
      "filter": "blocked",
      "sort": [
        "blocks:desc",
        "priority:desc"
      ]
    },
    "default": {
      "columns": [],
      "filter": "!terminal && (miss(start) || start <= now())",
      "sort": []
    },
    "owner": {
      "columns": [],
      "description": "Open tasks waiting on the maintainer",
      "filter": "assignee == \"max\" && !terminal",
      "sort": [
        "priority:desc"
      ]
    }
  }
