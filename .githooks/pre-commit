#!/usr/bin/env bash
# Pre-commit: four cheap assertions, no heavy work.
#
# 1. The memoized close gate already passed against this worktree. `just
#    check` records every sub-gate through mmz; `mmz --is-fresh --tag gate`
#    asserts them all without re-running anything (a stale or failed rule
#    names itself, so the fix is a fresh `just check`).
#
#    MINDTAPE_GATE_SCOPE=<reason> skips only this one assertion — the escape
#    hatch for a delegated worktree whose full aggregate (cold Rust build +
#    Typst docs site + Pagefind index) runs at integration, not per commit
#    (see CONTRIBUTING.md, Quality Gates). It never touches assertions 2-4
#    below, and `.githooks/commit-msg` refuses the commit unless the message
#    carries a matching `Gate-Scope: <reason>` trailer, so a scoped commit
#    can never look identical to a fully gated one in `git log`.
#
#    A commit that stages only `truth/tasks/**` skips it too: no gate reads
#    those files (see 3), so the assertion could only fail on a fresh fork
#    whose gates have never run, which blocks filing a task there.
# 2. No staged file names this machine's $HOME or checkout
#    (.githooks/local-paths says why only a hook can catch it).
# 3. Typst formatting under `truth/`. `truth/tasks/**` is deliberately outside
#    every mmz scope (.mmz/config.yaml: NOTE ON SCOPE — the close gate must
#    survive `mt flip`'s own writes), so a mis-formatted task file busts
#    nothing. The shared `truth/*.typ` files every task imports sit beside it.
#    The tree is small, so check all of it directly.
# 4. Task structure — the close gate delegates this here by policy.
set -eo pipefail
root="$(git rev-parse --show-toplevel)"
if [[ -n "${MINDTAPE_GATE_SCOPE:-}" ]]; then
    echo "pre-commit: MINDTAPE_GATE_SCOPE=${MINDTAPE_GATE_SCOPE} — skipping mmz --is-fresh --tag gate (commit-msg requires a matching Gate-Scope trailer)" >&2
elif git diff --cached --name-only | grep -qv '^truth/tasks/'; then
    direnv exec "$root" mmz --is-fresh --tag gate
fi
"$root/.githooks/local-paths"
direnv exec "$root" typstyle --check truth
exec direnv exec "$root" cargo run -q -p mindtape-cli --bin mt --target-dir target/mt-dev -- check -q
