#!/bin/sh
# scripts/locked <crate>@<version>: does Cargo.lock pin <crate> at <version> or
# later? Exit 0 when it does, 1 while it pins an older one, 2 when it pins none.
# It reads only the lockfile, so `mt` asks it offline. The newer version shows
# up when the dependency bot's pull request merges.
crate=${1%@*}
want=${1#*@}
awk -v crate="$crate" -v want="$want" '
  # -1, 0 or 1 as dotted version a sorts before, with or after b.
  function cmp(a, b,   x, y, i) {
    split(a, x, ".")
    split(b, y, ".")
    for (i = 1; i <= 3; i++) {
      if (x[i] + 0 != y[i] + 0) return x[i] + 0 < y[i] + 0 ? -1 : 1
    }
    return 0
  }
  $0 == "name = \"" crate "\"" {
    getline
    gsub(/^version = "|"$/, "")
    if (got == "" || cmp($0, got) > 0) got = $0
  }
  END {
    if (got == "") { print crate " is not in Cargo.lock"; exit 2 }
    print crate " " got " is locked"
    exit (cmp(got, want) >= 0 ? 0 : 1)
  }
' Cargo.lock
