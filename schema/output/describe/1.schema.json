{
  "$defs": {
    "SlotJson": {
      "description": "One template slot.",
      "properties": {
        "choices": {
          "description": "The values a `choice` slot accepts, or `null`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "default": {
          "description": "The default expression's source, or `null`.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "description": "The environment variable the slot reads, or `null`.",
          "type": [
            "string",
            "null"
          ]
        },
        "example": {
          "description": "A sample value, or `null`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Its value kind, such as `string` or `choice`.",
          "type": "string"
        },
        "name": {
          "description": "The slot's name.",
          "type": "string"
        },
        "prompt": {
          "description": "The prompt the editor and `--describe` show, or `null`.",
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "description": "Whether a value must be supplied when no default is present.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "required"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/mlavrinenko/mindtape/main/schema/output/describe/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The object `mt add --describe=json` prints: the template's slots, each with its kind, default and choices.",
  "properties": {
    "$schema": {
      "description": "The URL of the schema this object conforms to.",
      "type": "string"
    },
    "slots": {
      "description": "The template's slots, in declaration order.",
      "items": {
        "$ref": "#/$defs/SlotJson"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "slots"
  ],
  "title": "Mindtape template slots",
  "type": "object"
}
