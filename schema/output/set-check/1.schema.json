{
  "$defs": {
    "ProblemJson": {
      "description": "One problem as `mt check --json` prints it.",
      "properties": {
        "file": {
          "description": "The file the problem sits in, `/`-separated, or `null`.",
          "type": [
            "string",
            "null"
          ]
        },
        "hints": {
          "description": "The next steps the report names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "line": {
          "description": "The line in that file, or `null`.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "description": "The problem's message, without its place or rule.",
          "type": "string"
        },
        "notes": {
          "description": "The context the report adds.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "place": {
          "description": "The text the plain report starts with, `/`-separated like `file`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rule": {
          "description": "The rule that refused the task, or `null`.",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "description": "`error` or `warning`.",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "message",
        "hints",
        "notes"
      ],
      "type": "object"
    },
    "ProjectCheckJson": {
      "description": "One project's part of a set check.",
      "properties": {
        "ok": {
          "description": "Whether the project passed.",
          "type": "boolean"
        },
        "problems": {
          "description": "The problems the project reported.",
          "items": {
            "$ref": "#/$defs/ProblemJson"
          },
          "type": "array"
        },
        "project": {
          "description": "The project's name, as `mt at <name>` shows it.",
          "type": "string"
        },
        "tasks": {
          "description": "How many tasks the project loaded.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "project",
        "ok",
        "tasks",
        "problems"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/mlavrinenko/mindtape/main/schema/output/set-check/1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The object `mt @name check --json` prints: one report per project in the set.",
  "properties": {
    "$schema": {
      "description": "The URL of the schema this object conforms to.",
      "type": "string"
    },
    "projects": {
      "description": "The projects' reports, in set order.",
      "items": {
        "$ref": "#/$defs/ProjectCheckJson"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "projects"
  ],
  "title": "Mindtape set check",
  "type": "object"
}
